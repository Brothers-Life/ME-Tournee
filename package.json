{
  "name": "me-tournee",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @me/api dev",
    "dev:worker": "pnpm --filter @me/worker dev",
    "dev:panel": "pnpm --filter @me/panel dev",
    "dev:driver": "pnpm --filter @me/driver dev",
    "db:migrate": "pnpm --filter @me/db migrate",
    "db:seed": "pnpm --filter @me/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
